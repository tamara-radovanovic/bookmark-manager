# Copy to .env (git-ignored) — read by docker-compose.yml to configure the
# local Postgres container. Must match apps/backend/.env's DATABASE_URL.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=bookmark_manager
# 5433, not 5432 — kept off the default port because a native Postgres
# service commonly already owns 5432 on Windows dev machines.
POSTGRES_PORT=5433

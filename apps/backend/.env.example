# Copy this file to .env and fill in real values. .env itself is git-ignored.

# Must match the Postgres credentials in the root .env used by docker-compose.yml.
# Port 5433, not 5432 — see root .env.example for why.
DATABASE_URL=postgresql://user:password@localhost:5433/bookmark_manager

PORT=3000

# Unused until Phase 1 (auth) — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_signing_secret_here
